<?xml version="1.0" encoding="utf-8"?>
<!--
  iwan_nt.vcxproj - the iWAN NT transport driver.

  Shape follows WireGuardNT: the inner packets enter and leave through an NDIS
  miniport, the outer datagrams go through a kernel WSK UDP socket, and the
  frame transform runs synchronously in the calling context. There is exactly
  one data path per adapter and no worker thread pool.

  Build (Windows with WDK, from a VS developer prompt):

    msbuild driver\iwan_nt.vcxproj /p:Configuration=Release /p:Platform=x64

  Signing is left to the deployment step, as in the other drivers in this
  family: the toolset signing mode omits /fd and deletes the output, so the
  driver is signed in the guest with a self-signed certificate instead.

  The INF is not listed as an <Inf> item on purpose: a PnP INF needs a .cat,
  and the .cat is produced in the guest next to the signed .sys.
-->
<Project DefaultTargets="Build" ToolsVersion="Current"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{8D1E2E6E-7A49-4FA6-9C94-3E3ACF9A3D71}</ProjectGuid>
    <RootNamespace>iwannt</RootNamespace>
    <ProjectName>iwannt</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <SignMode>Off</SignMode>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>iwannt</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Sources are plain ASCII; the charset switches stay as a guard so that a
           future non-ASCII literal fails here instead of silently landing as C4566. -->
      <AdditionalOptions>/source-charset:utf-8 /execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <ExceptionHandling>false</ExceptionHandling>
      <PreprocessorDefinitions>_AMD64_;AMD64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- netio.lib provides Wsk*, ndis.lib the miniport entry points. -->
      <AdditionalDependencies>ndis.lib;netio.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Native</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>DBG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="iwan_nt.c" />
    <ClCompile Include="iwan_nt_demux.c" />
    <ClCompile Include="iwan_nt_frame.c" />
    <ClCompile Include="iwan_nt_ingress.c" />
    <ClCompile Include="iwan_nt_miniport.c" />
    <ClCompile Include="iwan_nt_ring.c" />
    <ClCompile Include="iwan_nt_transport.c" />
    <ClCompile Include="iwan_nt_tx.c" />
    <ClCompile Include="iwan_nt_wsk.c" />
    <ClCompile Include="iwan_nt_wsk_socket.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="iwan_nt_demux.h" />
    <ClInclude Include="iwan_nt_frame.h" />
    <ClInclude Include="iwan_nt_ingress.h" />
    <ClInclude Include="iwan_nt_miniport.h" />
    <ClInclude Include="iwan_nt_ring.h" />
    <ClInclude Include="iwan_nt_transport.h" />
    <ClInclude Include="iwan_nt_tx.h" />
    <ClInclude Include="iwan_nt_wsk.h" />
    <ClInclude Include="iwan_nt_wsk_socket.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
