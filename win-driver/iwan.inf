; iwan.inf -- install info for the Windows kernel data-plane driver (WFP callout)
;
; This is a non-PnP kernel-service INF: the driver binds no hardware and is started on demand
; by the client/service, like modprobe iwan on Linux. ServiceType=1 (kernel), StartType=3 (demand).
;
; Install (as administrator):
;   pnputil /add-driver iwan.inf /install
; Or (skip the driver store, drop the file and create the service directly):
;   rundll32 setupapi.dll,InstallHinfSection DefaultInstall 132 .\iwan.inf
; Uninstall:
;   rundll32 setupapi.dll,InstallHinfSection DefaultUninstall 132 .\iwan.inf
;
; Note: this file takes no part in the driver build (iwan.vcxproj has no <Inf> item). The WDK
; InfVerif by design rejects primitive driver INFs written as [DefaultInstall] (1420/1421/1423),
; which is exactly how a non-PnP kernel service is properly declared. Real installs use the
; sc.exe path in install.ps1 (see README); this INF is optional material for setupapi/pnputil.
;
; The architecture decorations (.NTamd64 / .NTx86) are a hard InfVerif requirement; both are
; spelled out here -- the driver builds for both x64 and x86.

[Version]
Signature   = "$Windows NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = iwan.cat
DriverVer   = 10/11/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
iwan.sys = 1,,

[DefaultInstall.NTamd64]
CopyFiles = @iwan.sys

[DefaultInstall.NTamd64.Services]
AddService = iwan,2,iwan_Service

[DefaultInstall.NTx86]
CopyFiles = @iwan.sys

[DefaultInstall.NTx86.Services]
AddService = iwan,2,iwan_Service

[iwan_Service]
DisplayName    = %ServiceName%
Description    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\iwan.sys

[DefaultUninstall.NTamd64]
DelFiles = @iwan.sys

[DefaultUninstall.NTamd64.Services]
DelService = iwan,0x200

[DefaultUninstall.NTx86]
DelFiles = @iwan.sys

[DefaultUninstall.NTx86.Services]
DelService = iwan,0x200

[Strings]
ProviderName = "iWAN"
DiskName     = "iWAN kernel data plane"
ServiceName  = "iWAN kernel data plane (WFP callout)"
ServiceDesc  = "Puts the iWAN data plane in the kernel: WFP callout encap on output, decap on input; packets never enter user mode."
