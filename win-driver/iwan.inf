; iwan.inf — Windows 内核数据面驱动（WFP callout）安装信息
;
; 这是一个"非 PnP 的内核服务"INF：驱动不绑定任何硬件，由客户端/服务按需启动，
; 对应 Linux 侧 modprobe iwan。ServiceType=1（内核驱动）、StartType=3（按需）。
;
; 安装（管理员）：
;   pnputil /add-driver iwan.inf /install
; 或（不走驱动库，直接落文件并建服务）：
;   rundll32 setupapi.dll,InstallHinfSection DefaultInstall 132 .\iwan.inf
; 卸载：
;   rundll32 setupapi.dll,InstallHinfSection DefaultUninstall 132 .\iwan.inf
;
; 注意：本文件**不参与驱动编译**（iwan.vcxproj 里没有 <Inf> 项）。原因是 WDK 的
; InfVerif 按设计拒绝 [DefaultInstall] 形式的 primitive 驱动 INF（1420/1421/1423），
; 而这类 INF 恰恰是非 PnP 内核服务的正统写法。实际安装走 install.ps1 的 sc.exe
; 路径（见 README），INF 是给"想用 setupapi/pnputil 装"的人留的备选材料。
;
; 架构装饰（.NTamd64 / .NTx86）是 InfVerif 的硬要求，两个架构都写全 —— 驱动本身
; 在 x64 与 x86 上都能编。

[Version]
Signature   = "$Windows NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = iwan.cat
DriverVer   = 10/11/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
iwan.sys = 1,,

[DefaultInstall.NTamd64]
CopyFiles = @iwan.sys

[DefaultInstall.NTamd64.Services]
AddService = iwan,2,iwan_Service

[DefaultInstall.NTx86]
CopyFiles = @iwan.sys

[DefaultInstall.NTx86.Services]
AddService = iwan,2,iwan_Service

[iwan_Service]
DisplayName    = %ServiceName%
Description    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\iwan.sys

[DefaultUninstall.NTamd64]
DelFiles = @iwan.sys

[DefaultUninstall.NTamd64.Services]
DelService = iwan,0x200

[DefaultUninstall.NTx86]
DelFiles = @iwan.sys

[DefaultUninstall.NTx86.Services]
DelService = iwan,0x200

[Strings]
ProviderName = "iWAN"
DiskName     = "iWAN kernel data plane"
ServiceName  = "iWAN kernel data plane (WFP callout)"
ServiceDesc  = "把 iWAN 数据面放进内核：WFP callout 出向封装、入向解封，报文不进用户态。"
