; iwanmp-proto.inf -- gives the iwanmp protocol edge a "network component" registration
;
; Why this file exists: NdisRegisterProtocolDriver only registers the driver as a protocol driver;
; what makes NDIS actually call BindAdapterHandlerEx is the protocol component instance plus
; each adapter component instance and its Linkage\UpperBind list. Reference: C:\Windows\INF\netlldp.inf
;   Class=NetTrans + ClassGUID={4d36e975-...}
;   [Install] Characteristics=0 / AddReg=Inst_Ndi
;   [Inst_Ndi] HKR,Ndi,Service,,"MsLldp"
;              HKR,Ndi\Interfaces, UpperRange,, noupper
;              HKR,Ndi\Interfaces, LowerRange,, ndis5
; The same shape is copied for iwanmp: the component id and the names in UpperBind must agree
; (both "iwanmp"), and LowerRange=ndis5 pairs with UpperRange=ndis5 of the inner miniport.
;
; Install: netcfg -l C:\iwan\iwanmp-proto.inf -c p -i iwanmp
; Remove:  netcfg -u iwanmp  (delete the component-instance key under Control\Network\... if needed)
;
; This file must stay pure ASCII: setupapi parses INFs as ANSI/UTF-16LE.

[Version]
    Signature   = "$Windows NT$"
    Class       = NetTrans
    ClassGUID   = {4d36e975-e325-11ce-bfc1-08002be10318}
    Provider    = %Iwan%
    PnpLockdown = 1
    DriverVer   = 10/20/2026,1.0.0.0

[Manufacturer]
    %Iwan% = Iwan, NTamd64

[Iwan.NTamd64]
    %IwanmpProtoDesc% = IwanmpProto.Install, iwanmp

[IwanmpProto.Install]
    Characteristics = 0
    AddReg          = Inst_Ndi

[Inst_Ndi]
    HKR, Ndi, Service, 0, "iwanmp"
    HKR, Ndi, BindForm, 0, "Iwanmp"
    HKR, Ndi\Interfaces, UpperRange, 0, "noupper"
    HKR, Ndi\Interfaces, LowerRange, 0, "ndis5"

[Strings]
    Iwan = "iwan"
    IwanmpProtoDesc = "iWAN Carrier Protocol"
