<?xml version="1.0" encoding="utf-8"?>
<!--
  iwanmp.vcxproj -- project for the NDIS miniport + protocol driver (second Windows data plane).

  Relation to iwan.vcxproj (the WFP plane): two binaries, one control plane. iwanmp.sys
  is itself the inner virtual adapter (miniport) and also registers a protocol driver that
  puts outer UDP straight onto the carrier adapter; no WFP injection API, and no
  non-paged-pool ceiling from in-flight injection.

  The two translation units deliberately use different NDIS version macros (the only awkward part):
  ndis.h exposes the miniport side and the protocol side through the NDIS_MINIPORT_DRIVER /
  NDIS630 macro families respectively, and does not allow both in one unit (measured in the first probe:
  the macro gate in km\ndis.h picks exactly one of the two modes). Hence:
    iwan_win_mp.c     takes the miniport macros (same set as Wintun)
    other sources      take the protocol/generic macros
  The two sides meet only through the NDIS-version-independent structs and prototypes in iwan_win.h.

  Build (on Windows with the WDK, from an administrator VS developer prompt):

    msbuild win-driver\iwanmp.vcxproj /p:Configuration=Release /p:Platform=x64

  Install (in the guest, test signing on and the self-signed cert trusted):
    devcon.exe install win-driver\iwanmp.inf iwanmp
-->
<Project DefaultTargets="Build" ToolsVersion="Current"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6D1A9B22-7C4E-4E2B-9F31-1A2B3C4D5E62}</ProjectGuid>
    <RootNamespace>iwanmp</RootNamespace>
    <ProjectName>iwanmp</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <!-- Same as iwan.vcxproj: the toolset built-in test signing omits /fd and deletes the output.
         Signing happens in the guest. -->
    <SignMode>Off</SignMode>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\mp\</IntDir>
    <TargetName>iwanmp</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Sources are plain ASCII; /utf-8 stays as a guard so a future non-ASCII literal
           cannot turn into C4566 and then C2220 under TreatWarningAsError. -->
      <AdditionalOptions>/source-charset:utf-8 /execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\src\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>IWAN_WIN_PLANE_MP;NDIS630;NDIS_WDM;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <ExceptionHandling>false</ExceptionHandling>
    </ClCompile>
    <Link>
      <!-- netio.lib: no routing API needed (the control plane supplies the next hop), but a few
           Ndis* helpers live in ndis.lib; wdmsec.lib provides IoCreateDeviceSecure. No fwpkclnt:
           this plane has no WFP. -->
      <AdditionalDependencies>ndis.lib;wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EntryPointSymbol>DriverEntry</EntryPointSymbol>
    </Link>
    <Inf>
      <TimeStamp>1.0.0.0</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="iwan_win_drv.c" />
    <ClCompile Include="iwan_win_session.c" />
    <ClCompile Include="iwan_win_frame.c" />
    <ClCompile Include="iwan_win_mpdata.c" />
    <ClCompile Include="iwan_win_proto.c" />
    <!-- The miniport half uses the miniport macros alone and does not inherit the project-level
         NDIS630: the two families (NDISnnn and NDISnnn_MINIPORT) must not appear in one unit.
         The 683 level is used (as in the Wintun reference) because
         NDIS_SUPPORT_NDIS680 is only set when declaring 6.80+, and both REVISION_3 of the
         characteristics table and SynchronousOidRequestHandler sit behind that gate -- registration
         must pick the newest revision at runtime, so it has to be visible at compile time. -->
    <ClCompile Include="iwan_win_mp.c">
      <PreprocessorDefinitions>NDIS_MINIPORT_DRIVER;NDIS620_MINIPORT;NDIS683_MINIPORT;NDIS_WDM;IWAN_WIN_PLANE_MP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="iwan_win.h" />
    <ClInclude Include="iwan_win_frame.h" />
    <ClInclude Include="..\src\common\iwan_win_abi.h" />
  </ItemGroup>
  <!-- Like iwan.inf, iwanmp.inf does not go into <Inf>: a PnP INF needs a .cat, and the .cat
       is produced in the guest with New-FileCatalog + Set-AuthenticodeSignature. Installation uses
       devcon install / pnputil; the INF stays in the tree as deployment material. -->

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
