<?xml version="1.0" encoding="utf-8"?>
<!--
  iwan.vcxproj - MSBuild project for the Windows kernel data-plane driver (WFP callout).

  This is a WDM driver (no KMDF: one less framework dependency, easier to test-sign); it links
  fwpkclnt.lib (WFP kernel API) + ndis.lib (NBL helpers) + wdmsec.lib (device ACL).
  Build (on Windows with the WDK, from an administrator VS developer prompt):

    msbuild win-driver\iwan.vcxproj /p:Configuration=Release /p:Platform=x64

  Linux counterpart in kernel/: iwan.sys is iwan.ko.
-->
<Project DefaultTargets="Build" ToolsVersion="Current"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6D1A9B20-7C4E-4E2B-9F31-1A2B3C4D5E60}</ProjectGuid>
    <RootNamespace>iwan</RootNamespace>
    <ProjectName>iwan</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <!-- Disable the toolset built-in test signing: it calls signtool without /fd, and modern
         signtool reports "No file digest algorithm specified", after which RemoveUnsignedOutput
         deletes the freshly linked iwan.sys and iwan.pdb (that is exactly what happened once:
         link succeeded, artifacts were gone). Signing happens on the VM side in vm-load.ps1 with
         New-SelfSignedCertificate + Set-AuthenticodeSignature; CI only compiles. -->
    <SignMode>Off</SignMode>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>iwan</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Sources are pure ASCII. /utf-8 is kept as a guard: if a non-ASCII literal ever
           comes back, the default execution charset (1252) would raise C4566, which under
           TreatWarningAsError becomes C2220 - a failure that once reported build success
           while iwan.sys was missing from the artifacts. -->
      <AdditionalOptions>/source-charset:utf-8 /execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\src\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <!-- NDIS630 only: the data plane uses NdisAllocateNetBufferListPool / NdisGetDataBuffer,
           whose 6.30 declarations require an explicit NDIS version macro.
           _KERNEL_MODE comes from the toolset /kernel switch and POOL_NX_ALLOCATION from wdm.h;
           redefining them here raises C4005, which under TreatWarningAsError becomes
           C2220 (the first real compile was stopped exactly this way). -->
      <PreprocessorDefinitions>NDIS630;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <ExceptionHandling>false</ExceptionHandling>
    </ClCompile>
    <Link>
      <AdditionalDependencies>fwpkclnt.lib;fwpuclnt.lib;netio.lib;ndis.lib;wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Entry point matches Linux: DriverEntry; the service name in the INF is iwan -->
      <EntryPointSymbol>DriverEntry</EntryPointSymbol>
    </Link>
    <Inf>
      <TimeStamp>1.0.0.0</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="iwan_win_drv.c" />
    <ClCompile Include="iwan_win_session.c" />
    <ClCompile Include="iwan_win_wfp.c" />
    <ClCompile Include="iwan_win_frame.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="iwan_win.h" />
    <ClInclude Include="iwan_win_frame.h" />
    <ClInclude Include="..\src\common\iwan_win_abi.h" />
  </ItemGroup>
  <!--
    There is deliberately no <Inf Include="iwan.inf" />: adding one triggers the WDK InfVerif,
    which by design rejects primitive driver INFs written as [DefaultInstall] (errors 1420/1421/1423),
    the very form a non-PnP kernel service uses. Installation goes through the sc.exe path in
    install.ps1; the INF stays in the tree as optional material (arch decorations and SourceDisksFiles included).
  -->

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
